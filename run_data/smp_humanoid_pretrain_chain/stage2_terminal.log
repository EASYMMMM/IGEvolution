        srl_endpos_obs: False
        asset: 
            assetFileName: mjcf/amp_humanoid_175.xml
        plane: 
            staticFriction: 1.0
            dynamicFriction: 1.0
            restitution: 0.0
        torque_threshold: 50
        upper_reward_w: 1
        srl_torque_reward_w: 0.001
        srl_load_cell_w: 0.0
        srl_root_force_reward_w: 0
        target_v_task: False
        autogen_model: True
        load_cell: True
        humanoid_load_cell_obs: False
        design_param_obs: False
