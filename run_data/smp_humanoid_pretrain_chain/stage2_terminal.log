            frequency: 600
            observations: 
                range: [0, 0.002]
                operation: additive
                distribution: gaussian
            actions: 
                range: [0.0, 0.02]
                operation: additive
                distribution: gaussian
            sim_params: 
                gravity: 
                    range: [0, 0.4]
                    operation: additive
                    distribution: gaussian
                    schedule: linear
                    schedule_steps: 3000
            actor_params: 
                humanoid: 
